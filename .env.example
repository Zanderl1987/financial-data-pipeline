SCHWAB_API_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=tokens.json

# SEC EDGAR — no key needed, but a valid User-Agent is required by SEC policy
EDGAR_USER_AGENT=YourAppName you@example.com

# FRED (St. Louis Fed) — free API key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
FRED_API_KEY_BACKUP=your_fred_backup_api_key_here

# EIA (U.S. Energy Information Administration) — free API key at https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here

# Hugging Face Hub — free account at https://huggingface.co
# Token: https://huggingface.co/settings/tokens (needs write permission)
# Repo:  create a dataset repo at https://huggingface.co/new-dataset (e.g. username/financial-fundamentals)
HF_TOKEN=your_hf_write_token_here
HF_DATASET_REPO=your_username/financial-fundamentals

# Finnhub — free API key at https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# YouTube Data API v3 — https://console.cloud.google.com/
YOUTUBE_API_V3_KEY=your_youtube_api_key_here

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Nasdaq Data Link (formerly Quandl) — https://data.nasdaq.com/account/profile
NASDAQ_DATA_LINK_API_KEY=your_nasdaq_data_link_api_key_here
QUANDL_API_KEY=your_quandl_api_key_here

# FINRA — https://developer.finra.org/
FINRA_API_KEY=your_finra_api_key_here

# IEX Cloud — https://iexcloud.io/
IEX_CLOUD_API_KEY=your_iex_cloud_api_key_here

# SimFin — https://simfin.com/api/v2/documentation/
SIMFIN_API_KEY=your_simfin_api_key_here

# NewsAPI — https://newsapi.org/
NEWSORG_API_KEY=your_newsapi_key_here

# Alpha Vantage — https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
ALPHA_VANTAGE_API_KEY_2=your_alpha_vantage_api_key_2_here

# Tiingo — https://www.tiingo.com/account/api/token
TIINGO_API_KEY=your_tiingo_api_key_here

# Social Sentiment.io — https://socialsentiment.io/
SOCIAL_SENTIMENT_IO_API_KEY=your_social_sentiment_api_key_here

# Reddit — free "script" app at https://www.reddit.com/prefs/apps (click "create another app")
# Choose type: script. Redirect URI: http://localhost:8080
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=financial-data-pipeline/1.0 (by u/your_username_here)

# AISStream — free real-time vessel tracking via WebSocket
# Register at https://aisstream.io/ (free tier; no credit card)
AISSTREAM_API_KEY=your_aisstream_api_key_here
