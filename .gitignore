.env
tokens.json
tokens.db
options_history_capture/
__pycache__/
*.pyc
*.parquet
.idea/
.worktrees/
.superpowers/

# Storage (data files — not tracked in git, but keep directory structure)
storage/**/*.parquet
storage/**/*.csv
# CIK map cache is regenerable — exclude it
storage/**/cik_map.json
storage/dividend_research_cache.json
storage/quality_reports/
storage/reports/
# HF fundamentals snapshot is a regenerable build artifact (built by
# build_fundamentals_dataset.py; the authoritative copy lives on HF)
storage/hf_fundamentals_snapshot/

# cot_reports library dumps temp files to working directory
Com95_16.txt
annualof.txt

storage/eval_registry/
storage/logs/
logs/

# Iceberg tables (constituents/, shipping/, pilot/): metadata + catalog DBs are
# local, regenerable state, same as storage/raw/ -- NOT git-synced. Baking an
# absolute clone-specific path into a table's metadata and then syncing only the
# metadata (never the gitignored *.parquet data) via git produces a "phantom"
# table that looks populated but reads zero rows from any other clone. See CLAUDE.md.
storage/iceberg/**/metadata/
storage/iceberg/constituents_catalog.db
storage/iceberg/pilot_catalog.db

# Regenerable progress state for the long-running universe backfill
schwab_universe_backfill_progress.json
