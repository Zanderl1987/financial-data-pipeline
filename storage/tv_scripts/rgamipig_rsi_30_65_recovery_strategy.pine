//@version=6
strategy(
     "RSI 30/65 Recovery Strategy",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     commission_type=strategy.commission.percent,
     commission_value=0,
     slippage=0,
     pyramiding=0,
     process_orders_on_close=true
)

rsiLength = input.int(14, "RSI Length")
buyLevel  = input.float(30, "Buy Level")
sellLevel = input.float(65, "Sell Level")

rsiValue = ta.rsi(close, rsiLength)

// Trade state
var bool inLong = false
var bool buyArmed = false
var bool sellArmed = false

bool buySignal = false
bool sellSignal = false

// BUY:
// RSI crosses below 30, then comes back above 30
if not inLong
    if ta.crossunder(rsiValue, buyLevel)
        buyArmed := true

    if ta.crossover(rsiValue, buyLevel) and buyArmed
        buySignal := true
        inLong := true
        buyArmed := false
        sellArmed := false

// SELL:
// RSI crosses above 65, then comes back below 65
if inLong
    if ta.crossover(rsiValue, sellLevel)
        sellArmed := true

    if ta.crossunder(rsiValue, sellLevel) and sellArmed
        sellSignal := true
        inLong := false
        sellArmed := false
        buyArmed := false

buyMessage =
     '{"action":"buy","symbol":"' +
     syminfo.ticker +
     '","price":"' +
     str.tostring(close) +
     '","timeframe":"' +
     timeframe.period +
     '"}'

sellMessage =
     '{"action":"sell","symbol":"' +
     syminfo.ticker +
     '","price":"' +
     str.tostring(close) +
     '","timeframe":"' +
     timeframe.period +
     '"}'

// Buy order
if buySignal
    strategy.entry(
         "Long",
         strategy.long,
         alert_message=buyMessage
    )

// Sell order
if sellSignal
    strategy.close(
         "Long",
         alert_message=sellMessage
    )

// Chart markers
plotshape(
     buySignal,
     title="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     text="BUY",
     textcolor=color.white,
     size=size.small
)

plotshape(
     sellSignal,
     title="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     text="SELL",
     textcolor=color.white,
     size=size.small
)
